# ==============================
# MIKROTIK CONFIGURATION
# ==============================
MIKROTIK_HOST=192.168.1.1
MIKROTIK_PORT=8728
MIKROTIK_USERNAME=monitor
MIKROTIK_PASSWORD=password
MIKROTIK_USE_SSL=false
MIKROTIK_VERIFY_SSL=false

# ==============================
# INTERFACE MONITORING
# ==============================
# Comma-separated list of interface names to monitor
MONITORED_INTERFACES=ether1-BAROKAH,ether2-BIZ,ether3-WAHED

# ==============================
# POLLING
# ==============================
# Polling interval in seconds
POLL_INTERVAL=5

# ==============================
# DATABASE
# ==============================
DATABASE_PATH=./data/traffic.db

# ==============================
# WEB SERVER
# ==============================
WEB_HOST=0.0.0.0
WEB_PORT=8080

# ==============================
# GRAPH CONFIGURATION
# ==============================
# Comma-separated duration options for frontend chart dropdown
GRAPH_PERIODS=5m,15m,30m,1h,12h,24h

# Default graph period (must be one of GRAPH_PERIODS)
GRAPH_DEFAULT_PERIOD=15m

# Threshold duration (period <= GRAPH_REALTIME_MAX is treated as real-time)
GRAPH_REALTIME_MAX=30m

# Frontend refresh interval in milliseconds for real-time mode
GRAPH_REFRESH_INTERVAL=5000

# Maximum number of data points returned for chart downsampling
GRAPH_MAX_POINTS=500

# ==============================
# DATA RETENTION
# ==============================
# Retention period for historical data cleanup (e.g. 30d, 7d, 12h)
DATA_RETENTION=30d
