# ==============================
# MIKROTIK CONFIGURATION
# ==============================
MIKROTIK_HOST=192.168.1.1
MIKROTIK_PORT=8728
MIKROTIK_USERNAME=monitor
MIKROTIK_PASSWORD=password
MIKROTIK_USE_SSL=false
MIKROTIK_VERIFY_SSL=false

# ==============================
# INTERFACE MONITORING
# ==============================
# Comma-separated list of interface names to monitor
MONITORED_INTERFACES=ether1-BAROKAH,ether2-BIZ,ether3-WAHED

# ==============================
# POLLING
# ==============================
# Polling interval in seconds
POLL_INTERVAL=5

# ==============================
# DATABASE
# ==============================
DATABASE_PATH=./data/traffic.db

# ==============================
# WEB SERVER
# ==============================
WEB_HOST=0.0.0.0
WEB_PORT=8080

# ==============================
# GRAPH CONFIGURATION
# ==============================
# Comma-separated duration options for frontend chart dropdown
GRAPH_PERIODS=5m,15m,30m,1h,12h,24h

# Default graph period (must be one of GRAPH_PERIODS)
GRAPH_DEFAULT_PERIOD=15m

# Threshold duration (period <= GRAPH_REALTIME_MAX is treated as real-time)
GRAPH_REALTIME_MAX=30m

# Frontend refresh interval in milliseconds for real-time mode
GRAPH_REFRESH_INTERVAL=5000

# Maximum number of data points returned for chart downsampling
GRAPH_MAX_POINTS=500

# ==============================
# DATA RETENTION
# ==============================
# Retention period for historical data cleanup (e.g. 30d, 7d, 12h)
DATA_RETENTION=30d

# ==============================
# TELEGRAM BOT & ISOLATED IP
# ==============================
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# CIDR Subnet for Isolated PPPoE Clients
ISOLATED_IP_RANGE=10.127.0.0/18

# Batas Concurrency Task Telegram Bot
MAX_CONCURRENT_TASKS=10

# ==============================
# OLT SNMP MONITORING (Opsional)
# ==============================
# Set true untuk mengaktifkan fitur OLT monitoring
OLT_ENABLED=false

# Nama identitas OLT (untuk label pada pesan Telegram)
OLT_NAME=OLT-UTAMA

# IP Address OLT
OLT_HOST=192.168.88.2

# Port SNMP (default: 161)
OLT_PORT=161

# Versi SNMP: 1, 2c, atau 3
OLT_SNMP_VERSION=2c

# Community String SNMP (Read-Only)
OLT_SNMP_COMMUNITY=public

# SNMP Timeout (detik) dan Retry
SNMP_TIMEOUT=5
SNMP_RETRIES=2

# ==============================
# OLT OPTICAL POWER & THRESHOLD
# ==============================
# Threshold dalam dBm (<= threshold dianggap redaman tinggi)
OLT_RX_POWER_THRESHOLD=-25

# Scale faktor konversi nilai mentah SNMP ke dBm
# HSGQ: 100 (-2958 / 100 = -29.58 dBm)
# ZTE/Fiberhome: 10 (-253 / 10 = -25.3 dBm)
OLT_RX_POWER_SCALE=100

# ==============================
# OLT OID CONFIGURATION
# ==============================
# OID Status ONT (Wajib jika OLT_ENABLED=true)
OID_ONT_STATUS=1.3.6.1.4.1.50224.3.3.2.1.8

# OID RX/TX Optical Power
OID_ONT_RX_POWER=1.3.6.1.4.1.50224.3.3.3.1.4
OID_ONT_TX_POWER=1.3.6.1.4.1.50224.3.3.3.1.5

# OID Vendor & Model ONT (gabungan ditampilkan sebagai "Model" pada pesan)
OID_ONT_VENDOR=1.3.6.1.4.1.50224.3.3.2.1.25
OID_ONT_MODEL=1.3.6.1.4.1.50224.3.3.2.1.26

# OID Serial Number (opsional, alternatif jika tidak pakai Vendor+Model)
OID_ONT_SERIAL=

# OID Nama/Deskripsi ONT
OID_ONT_NAME=1.3.6.1.4.1.50224.3.3.2.1.2

# ==============================
# OLT STATUS VALUE MAPPING
# ==============================
ONT_STATUS_ONLINE_VALUES=1
ONT_STATUS_OFFLINE_VALUES=2

